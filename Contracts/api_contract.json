{
  "stage": "API contract - Contract-first Foundation",
  "primary_query_endpoints": ["/query/check", "/query/execute"],
  "high_risk_confirmation": {
    "visible_to_ui": true,
    "length": 4,
    "numeric": true,
    "generated_by": "backend",
    "not_generated_by": "LLM",
    "bound_to": ["check_id", "sql_hash", "target", "expiry"]
  },
  "secret_policy": {
    "raw_secret_in_response": false,
    "json_secret_fields": ["api_key_env", "password_env"],
    "masked_status_only": true
  }
}
