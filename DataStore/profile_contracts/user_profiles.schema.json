{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safy.local/schemas/user-profile.json",
  "title": "SAFY local login user profile",
  "type": "object",
  "required": [
    "profile_id",
    "profile_type",
    "display_name",
    "username",
    "password_env",
    "active",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_type": {"const": "user"},
    "display_name": {"type": "string", "minLength": 1},
    "username": {"type": "string", "minLength": 1},
    "password_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "active": {"type": "boolean"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "password": false,
    "raw_password": false,
    "raw_secret": false,
    "secret": false,
    "token": false
  },
  "additionalProperties": false
}
