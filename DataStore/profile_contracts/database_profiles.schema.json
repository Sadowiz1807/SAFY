{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safy.local/schemas/database-profile.json",
  "title": "SAFY persisted database profile",
  "type": "object",
  "required": [
    "profile_id",
    "profile_type",
    "display_name",
    "database_type",
    "provider",
    "driver",
    "dbms",
    "connection_kind",
    "execution_transport",
    "user_query_access_mode",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "profile_id": {"type": "string", "minLength": 1},
    "profile_type": {"const": "database"},
    "profile_name": {"type": ["string", "null"]},
    "display_name": {"type": "string", "minLength": 1},
    "schema_version": {"type": ["string", "integer"]},
    "database_type": {"enum": ["postgresql", "supabase_rpc", "mysql", "sqlite", "sqlserver", "oracle"]},
    "provider": {"enum": ["self_hosted", "supabase", "google_cloud_sql", "aws_aurora"]},
    "driver": {"enum": ["postgresql", "supabase_rpc", "mysql", "sqlite", "sqlserver", "oracle"]},
    "dbms": {"enum": ["postgresql", "supabase_rpc", "mysql", "sqlite", "sqlserver", "oracle"]},
    "engine": {"type": ["string", "null"]},
    "connection_kind": {"enum": ["native_sql", "supabase_rpc"]},
    "execution_transport": {"enum": ["native_driver", "postgrest_rpc"]},
    "base_url": {"type": ["string", "null"]},
    "host": {"type": ["string", "null"]},
    "port": {"type": ["integer", "null"], "minimum": 0, "maximum": 65535},
    "instance": {"type": ["string", "null"]},
    "database": {"type": ["string", "null"]},
    "schema": {"type": ["string", "null"]},
    "database_schema": {"type": ["string", "null"]},
    "sqlite_path": {"type": ["string", "null"]},
    "allowed_root": {"type": ["string", "null"]},
    "service_name": {"type": ["string", "null"]},
    "sid": {"type": ["string", "null"]},
    "authentication": {"enum": ["password", "api_key", "none", "sql_server", "windows", null]},
    "trusted_connection": {"type": "boolean"},
    "username": {"type": ["string", "null"]},
    "secret_kind": {"enum": ["password", "api_key", "none", null]},
    "secret_mode": {"enum": ["none", "env"]},
    "password_mode": {"enum": ["none", "env"]},
    "password_env": {"type": ["string", "null"], "pattern": "^$|^[A-Z][A-Z0-9_]*$"},
    "api_key_env": {"type": ["string", "null"], "pattern": "^$|^[A-Z][A-Z0-9_]*$"},
    "secret_env": {"type": ["string", "null"], "pattern": "^$|^[A-Z][A-Z0-9_]*$"},
    "has_raw_secret": {"type": "boolean", "description": "Legacy browser-facing configured-secret status flag; no raw value is stored."},
    "ssl_mode": {"type": ["string", "null"]},
    "encrypt": {"type": "boolean"},
    "trust_server_certificate": {"type": "boolean"},
    "odbc_driver": {"type": ["string", "null"]},
    "sql_rpc_function": {"type": ["string", "null"]},
    "sql_rpc_argument": {"type": ["string", "null"]},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "user_query_access_mode": {"enum": ["credential_permissions", "read_only", "disabled"]},
    "read_only": {"type": "boolean"},
    "real_db_readonly": {"type": "boolean"},
    "active": {"type": "boolean"},
    "activation_generation": {"type": "integer", "minimum": 0},
    "context_generation": {"type": "integer", "minimum": 0},
    "endpoint_key": {"type": ["string", "null"]},
    "last_test_status": {"type": ["string", "null"]},
    "last_test_at": {"type": ["string", "null"]},
    "last_test_error_code": {"type": ["string", "null"]},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1},
    "api_key": false,
    "password": false,
    "raw_secret": false,
    "raw_api_key": false,
    "raw_password": false,
    "secret": false,
    "token": false
  },
  "allOf": [
    {
      "if": {"properties": {"database_type": {"const": "sqlite"}}, "required": ["database_type"]},
      "then": {"required": ["database", "sqlite_path"]}
    },
    {
      "if": {"properties": {"database_type": {"const": "supabase_rpc"}}, "required": ["database_type"]},
      "then": {"required": ["base_url", "host", "port", "sql_rpc_function", "sql_rpc_argument"]}
    },
    {
      "if": {"properties": {"database_type": {"enum": ["postgresql", "mysql", "sqlserver", "oracle"]}}, "required": ["database_type"]},
      "then": {"required": ["host", "port", "database"]}
    }
  ],
  "additionalProperties": true
}
