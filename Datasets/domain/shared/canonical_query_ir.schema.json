{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "operation",
    "entities",
    "filters",
    "projection"
  ],
  "properties": {
    "operation": {
      "type": "string"
    },
    "entities": {
      "type": "array"
    },
    "filters": {
      "type": "array"
    },
    "projection": {
      "type": "array"
    },
    "ordering": {
      "type": "array"
    },
    "limit": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
