{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://safy.local/contracts/schema-graph-output-2.0.0.json",
  "title": "SAFY Schema Graph Output",
  "type": "object",
  "required": [
    "schema_version",
    "database_profile_id",
    "database_name",
    "graph",
    "nodes",
    "relationships",
    "statistics",
    "warnings",
    "status",
    "tables",
    "edges",
    "table_count",
    "edge_count"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "database_profile_id": {"type": ["string", "null"]},
    "database_name": {"type": ["string", "null"]},
    "driver": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "graph": {"$ref": "#/$defs/graphMetadata"},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "statistics": {"$ref": "#/$defs/statistics"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "schema_hash": {"type": ["string", "null"]},
    "refreshed_at": {"type": ["string", "null"]},
    "status": {"enum": ["ready", "empty"]},
    "source": {"type": "string"},
    "tables": {"type": "array", "items": {"type": "object"}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "table_count": {"type": "integer", "minimum": 0},
    "edge_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true,
  "$defs": {
    "graphMetadata": {
      "type": "object",
      "required": ["id", "name", "database_engine", "generated_at", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": ["string", "null"]},
        "database_engine": {"type": ["string", "null"]},
        "generated_at": {"type": ["string", "null"]},
        "status": {"enum": ["ready", "empty"]}
      },
      "additionalProperties": false
    },
    "column": {
      "type": "object",
      "required": [
        "id",
        "name",
        "ordinal_position",
        "data_type",
        "nullable",
        "primary_key",
        "foreign_key",
        "unique",
        "default",
        "generated",
        "sensitive"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[^.]+\\..+\\..+$"},
        "name": {"type": "string", "minLength": 1},
        "ordinal_position": {"type": "integer", "minimum": 1},
        "data_type": {"type": "string"},
        "nullable": {"type": "boolean"},
        "primary_key": {"type": "boolean"},
        "foreign_key": {"type": "boolean"},
        "unique": {"type": "boolean"},
        "default": {},
        "generated": {},
        "sensitive": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "primaryKey": {
      "type": "object",
      "required": ["name", "columns"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "columns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "uniqueConstraint": {
      "type": "object",
      "required": ["name", "columns"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "columns": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "index": {
      "type": "object",
      "required": ["name", "columns", "unique", "definition", "method"],
      "properties": {
        "name": {"type": ["string", "null"]},
        "columns": {"type": "array", "items": {"type": "string"}},
        "unique": {"type": "boolean"},
        "definition": {"type": ["string", "null"]},
        "method": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "node_type",
        "schema",
        "name",
        "display_name",
        "columns",
        "primary_key",
        "unique_constraints",
        "indexes",
        "row_count_estimate",
        "metadata"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[^.]+\\..+$"},
        "node_type": {"enum": ["table", "view", "materialized_view", "partition"]},
        "schema": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "columns": {"type": "array", "items": {"$ref": "#/$defs/column"}},
        "primary_key": {"$ref": "#/$defs/primaryKey"},
        "unique_constraints": {"type": "array", "items": {"$ref": "#/$defs/uniqueConstraint"}},
        "indexes": {"type": "array", "items": {"$ref": "#/$defs/index"}},
        "row_count_estimate": {"type": ["integer", "number", "null"]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "endpoint": {
      "type": "object",
      "required": ["node_id", "columns"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^[^.]+\\..+$"},
        "columns": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": [
        "id",
        "relationship_type",
        "source",
        "target",
        "constraint_name",
        "cardinality",
        "on_update",
        "on_delete",
        "nullable",
        "evidence",
        "confidence",
        "metadata"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "relationship_type": {
          "enum": [
            "foreign_key",
            "inheritance",
            "view_dependency",
            "materialized_view_dependency",
            "partition_parent",
            "association",
            "inferred"
          ]
        },
        "source": {"$ref": "#/$defs/endpoint"},
        "target": {"$ref": "#/$defs/endpoint"},
        "constraint_name": {"type": ["string", "null"]},
        "cardinality": {"type": ["string", "null"]},
        "on_update": {"type": ["string", "null"]},
        "on_delete": {"type": ["string", "null"]},
        "nullable": {"type": ["boolean", "null"]},
        "evidence": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "statistics": {
      "type": "object",
      "required": [
        "node_count",
        "table_count",
        "view_count",
        "materialized_view_count",
        "column_count",
        "relationship_count",
        "foreign_key_count",
        "inheritance_count",
        "partition_relationship_count",
        "isolated_node_count"
      ],
      "properties": {
        "node_count": {"type": "integer", "minimum": 0},
        "table_count": {"type": "integer", "minimum": 0},
        "view_count": {"type": "integer", "minimum": 0},
        "materialized_view_count": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 0},
        "relationship_count": {"type": "integer", "minimum": 0},
        "foreign_key_count": {"type": "integer", "minimum": 0},
        "inheritance_count": {"type": "integer", "minimum": 0},
        "partition_relationship_count": {"type": "integer", "minimum": 0},
        "isolated_node_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
