# Copy this file to Docker/.env for local database-service tests.
# Values are local-only defaults; change before exposing services.
SAFY_SQLSERVER_PORT=14333
SAFY_SQLSERVER_SA_PASSWORD=change_me_sqlserver_sa
SAFY_SQLSERVER_PASSWORD=change_me_sqlserver_ro

SAFY_ORACLE_PORT=1522
SAFY_ORACLE_SYS_PASSWORD=change_me_oracle_sys
SAFY_ORACLE_OWNER_PASSWORD=change_me_oracle_owner
SAFY_ORACLE_PASSWORD=change_me_oracle_ro

SAFY_SQLSERVER_DOCKER_REQUIRED=0
SAFY_ORACLE_DOCKER_REQUIRED=0
